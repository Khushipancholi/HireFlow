# Environment Variables for HireFlow
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hireflow?schema=public"
JWT_SECRET="hireflow-super-secret-jwt-key-2026-production-ready"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="hireflow-nextauth-secret-key-32-chars-long"

# AI Configuration (Ollama Local)
AI_PROVIDER="ollama"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3"

# App Port
PORT=3000

